# Robot Teleoperation UI Configuration
# Copy this file to .env and adjust values for your setup

# Server Configuration
TELEOP_HOST=0.0.0.0
TELEOP_PORT=8080

# Robot Connection
ROBOT_IP=192.168.1.100
ROBOT_PORT=3333

# Velocity Limits (adjust based on your robot's capabilities)
MAX_LINEAR_VEL=1.0      # meters per second
MAX_ANGULAR_VEL=2.0     # radians per second

# Safety Configuration
COMMAND_TIMEOUT=1.0     # seconds - robot stops if no command received
UPDATE_RATE_HZ=20       # Hz - how often to send commands

# Example configurations for different scenarios:

# Conservative (slower, safer):
# MAX_LINEAR_VEL=0.5
# MAX_ANGULAR_VEL=1.0

# Aggressive (faster):
# MAX_LINEAR_VEL=2.0
# MAX_ANGULAR_VEL=3.0

# High update rate (lower latency, more network traffic):
# UPDATE_RATE_HZ=50

# Low update rate (less traffic, slightly higher latency):
# UPDATE_RATE_HZ=10
