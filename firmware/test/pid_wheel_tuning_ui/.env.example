# Example environment variables for PID Wheel Tuning Interface
# Copy this file to .env and adjust values as needed

# Server configuration
PID_TUNING_HOST=0.0.0.0
PID_TUNING_PORT=8081

# Robot connection
ROBOT_IP=192.168.1.100
ROBOT_PORT=3333

# Telemetry configuration
SAMPLING_RATE_HZ=50
MAX_WHEEL_VEL=50.0
MAX_CONTROL=100.0
